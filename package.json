{
  "name": "crimson-onslaught",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:csp": "playwright test -c playwright.csp.config.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:itch": "CSP_ALL_BROWSERS=1 playwright test -c playwright.csp.config.ts itch-iframe",
    "package:itch": "node scripts/package-itch.mjs",
    "art:cut": "node scripts/cut-sheets.mjs",
    "art:menu": "node scripts/prep-menu-art.mjs",
    "art:strip": "node scripts/strip-provenance.mjs",
    "audio:gen": "node scripts/gen-audio.mjs",
    "audio:cut": "node scripts/cut-audio.mjs",
    "sweep": "node scripts/sweep/run.mjs",
    "sweep:summary": "node scripts/sweep/summary.mjs"
  },
  "dependencies": {
    "phaser": "~3.88.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
