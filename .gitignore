# Dependencies / build
node_modules/
dist/
dist-csp/
.vite/

# Test output
sweep-results/
coverage/
playwright-report/
test-results/

# Secrets — never committed
.env
.env.*
!.env.example

# Per-agent scratch memory and worktrees. Local-only: these record absolute
# paths from the machine that wrote them, so committing them would publish a
# local username.
.claude/agent-memory/
**/.claude/agent-memory/
.claude/worktrees/
# Local editor / preview launch config
.claude/launch.json
# Local agent settings (permissions, per-machine paths)
.claude/settings.local.json
**/.claude/settings.local.json

# OS / editor
.DS_Store
*.swp
